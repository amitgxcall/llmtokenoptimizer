# --- Provider keys ---
ANTHROPIC_API_KEY=sk-ant-...
OPENAI_API_KEY=sk-...

# --- Proxy ---
LTO_PORT=8788
LTO_DASHBOARD_PORT=8789
# LTO_DB_PATH=C:/Users/you/.lto/lto.db

# --- Anthropic-side optimizations (all default ON) ---
LTO_PROMPT_CACHING=1            # inject cache_control markers
LTO_TOKEN_EFFICIENT_TOOLS=1     # token-efficient-tools-2025-02-19 beta
LTO_MEMORY_TOOL=0               # context-management-2025-06-27 beta (off by default)

# --- Model routing defaults ---
LTO_ANTHROPIC_MODEL=claude-opus-4-7
LTO_ANTHROPIC_CHEAP_MODEL=claude-haiku-4-5-20251001
LTO_OPENAI_MODEL=gpt-4o
LTO_OPENAI_CHEAP_MODEL=gpt-4o-mini

# --- Local Ollama (for embeddings + optional intent classification) ---
LTO_OLLAMA=1
OLLAMA_BASE_URL=http://localhost:11434
LTO_INTENT_MODEL=qwen2.5-coder:1.5b
LTO_EMBED_MODEL=bge-m3

# --- Helper LLM tier (OPT-IN, default off) ---
# LTO never *needs* an external call to optimize — all passes have local
# fallbacks. The helper tier is purely additive: a small/cheap/free model
# improves intent classification on borderline cases. Pick one:
#
#   local-only   default. No outbound helper calls. Rule-based intent only.
#   ollama       use the local Ollama model above (still local).
#   groq         FREE tier — llama-3.3-70b-versatile. Needs GROQ key.
#   cerebras     FREE tier — llama-3.3-70b. Needs Cerebras key.
#   deepseek     very cheap — $0.27 in / $1.10 out per 1M.
#   anthropic    Haiku 4.5 — $0.80 in / $4.00 out per 1M.
#   openai       gpt-4o-mini — $0.15 in / $0.60 out per 1M.
#   custom       any OpenAI-compatible endpoint (vLLM, LM Studio, Together…).
#
LTO_HELPER_MODE=local-only
# LTO_HELPER_API_KEY=...
# LTO_HELPER_BASE_URL=...      # for "custom"
# LTO_HELPER_MODEL=...         # override the per-mode default
LTO_HELPER_DAILY_BUDGET_USD=0.50  # hard cap; over budget = fall back to local

# --- MCP server (OPT-IN, default off) ---
# Lets Claude Code / Claude Desktop introspect savings + patterns.
# Run separately: `npm run mcp`. Does nothing unless enabled here AND wired
# into your MCP client config.
LTO_MCP_ENABLED=0
LTO_MCP_TRANSPORT=stdio          # stdio | http
LTO_MCP_HTTP_PORT=8790
