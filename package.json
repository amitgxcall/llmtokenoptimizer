{
  "name": "llmtokenoptimizer",
  "version": "0.1.0",
  "description": "Local proxy that cuts LLM token cost 40-70% for GHCP / Cursor / Claude Code via intent-aware pruning, semantic caching, learning memory, and command-output slimming.",
  "main": "dist/server.js",
  "bin": {
    "lto-slim": "dist/slimmer/cli.js"
  },
  "scripts": {
    "build": "tsc",
    "dev": "tsx watch src/server.ts",
    "start": "node dist/server.js",
    "ledger": "tsx src/ledger/cli.ts",
    "ledger:serve": "tsx src/ledger/dashboard.ts",
    "mcp": "tsx src/mcp/server.ts",
    "slim": "tsx src/slimmer/cli.ts",
    "test": "node --import tsx --test tests/unit/*.test.ts tests/integration/*.test.ts",
    "test:unit": "node --import tsx --test tests/unit/*.test.ts",
    "test:integration": "node --import tsx --test tests/integration/*.test.ts",
    "test:smoke": "npm run build && node dist/scripts/smoke.js"
  },
  "dependencies": {
    "@hono/node-server": "^1.13.7",
    "better-sqlite3": "^11.7.0",
    "hono": "^4.6.14",
    "sqlite-vec": "^0.1.6",
    "ulid": "^2.3.0",
    "yaml": "^2.6.1",
    "zod": "^3.24.1"
  },
  "devDependencies": {
    "@types/better-sqlite3": "^7.6.12",
    "@types/node": "^22.10.2",
    "tsx": "^4.19.2",
    "typescript": "^5.7.2"
  },
  "engines": {
    "node": ">=20"
  },
  "license": "MIT"
}
